# Copy to .env and fill in. Never commit the filled-in version.

# Neon Postgres POOLED connection string — note the "-pooler" in the hostname.
# Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Postgres DIRECT connection string — the same host without "-pooler".
# Used only by prisma migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Any random 32+ character string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Vercel Blob read/write token, from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# Where this app is deployed, if anywhere. Nothing in the code reads it; it is
# documentation, kept out of the repo so a public checkout doesn't advertise a
# personal deployment. On Vercel the platform also exposes the same thing as
# VERCEL_PROJECT_PRODUCTION_URL at build and runtime.
APP_PRODUCTION_URL="https://your-project.vercel.app"
